# === Public (client, VITE_*) ===
# Supabase eksternal (bukan Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudinary eksternal (unsigned client-side upload)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# URL publik aplikasi (redirect email recovery) — mis. domain Cloudflare
VITE_SITE_URL=

# === Server-only (JANGAN di-prefix VITE_) ===
# Service role Supabase untuk operasi admin server function
LPK_SUPABASE_URL=
LPK_SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary admin (hapus media) — signed server-side
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
